@page "/certification"
@using Terminal.Admin.App.Data
@using BlazorBootstrap
@inject PpsProvider PpsProvider
@inject AggregationBlockProvider AggregationBlockProvider
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Certification</PageTitle>

<div class="d-flex flex-column gap-3">
    
    @* Panel A: Configuration & Visualization *@
    <div class="card shadow-sm">
        <div class="card-body">
            @* Input Fields *@
            <div class="row mb-4">
                <div class="col-md-4">
                    <label class="form-label field-label">Aggregation block</label>
                    <select class="form-select custom-field" @bind="SelectedBlock">
                        <option value="Select">Select</option>
                        @foreach (var block in blocks)
                        {
                            <option value="@block">@block</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label field-label">Select PpS</label>
                    <select class="form-select custom-field" @bind="SelectedPps">
                        <option value="Select">Select</option>
                        @foreach (var pps in ppsList)
                        {
                            <option value="@pps">@pps</option>
                        }
                    </select>
                </div>
            </div>

            @* Parameter Displays *@
            <div class="row mb-4">
                <div class="col-md-4">
                    <label class="form-label field-label">PDG (MW)</label>
                    <input type="text" class="form-control custom-field" placeholder="0.00" disabled="@(!IsBasicFieldsEnabled)" value="@Pdg" @oninput="OnPdgChanged" />
                </div>
                <div class="col-md-4">
                    <label class="form-label field-label">ActivationPower</label>
                    <input type="text" class="form-control custom-field" placeholder="0.00" disabled="@(!IsBasicFieldsEnabled)" value="@ActivationPower" @oninput="OnActivationPowerChanged" />
                </div>
                <div class="col-md-4">
                    <label class="form-label field-label">Trend</label>
                    <input type="text" class="form-control custom-field" placeholder="0.00" disabled="@(!IsTrendEnabled)" value="@Trend" @oninput="OnTrendChanged" />
                </div>
            </div>

            @* Visualization Area *@
            <div class="visualization-area bg-light rounded p-2" style="height: 300px;">
                <canvas id="certificationChart" style="width:100%; height:100%;"></canvas>
            </div>
        </div>
    </div>

    @* Panel B: Action Control *@
    <div class="card shadow-sm">
        <div class="card-body d-flex justify-content-center p-2">
            <button class="btn btn-primary px-5" disabled>Start test</button>
        </div>
    </div>

    @* Panel C: Assistance *@
    <div class="card shadow-sm">
        <div class="card-body p-2">
            <button type="button" class="btn btn-primary" @onclick="ShowInstructions">Show instructions</button>
        </div>
    </div>

</div>

<Modal @ref="instructionsModal" Title="Instructions" IsVerticallyCentered="true" Size="ModalSize.Large">
    <BodyTemplate>
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Time of Execution</th>
                    <th>Power (MW)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var instr in instructions)
                {
                    <tr>
                        <td>@instr.Time</td>
                        <td>@instr.Power MW</td>
                    </tr>
                }
            </tbody>
        </table>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="HideModal">Close</Button>
    </FooterTemplate>
</Modal>

<style>
    .field-label {
        font-weight: 600;
        color: var(--color-slate-grey);
        font-size: 0.85rem;
        text-transform: uppercase;
        margin-bottom: 0.5rem;
    }

    .custom-field {
        height: 45px;
        border-color: var(--color-input-border);
        border-radius: 4px;
        background-color: var(--color-pure-white);
        color: var(--color-charcoal);
        font-size: 0.95rem;
    }

    .custom-field:disabled,
    .custom-field[disabled],
    .custom-field[readonly] {
        background-color: #f8f9fa;
        color: var(--color-slate-grey);
    }
    
    .custom-field:focus {
        border-color: var(--color-deep-cerulean);
        box-shadow: 0 0 0 0.2rem rgba(0, 124, 165, 0.25);
    }
</style>

@code {
    private List<string> ppsList = new();
    private List<string> blocks = new();
    
    private string _selectedBlock = "Select";
    private string _selectedPps = "Select";
    private string SelectedBlock
    {
        get => _selectedBlock;
        set
        {
            if (_selectedBlock != value)
            {
                _selectedBlock = value;
                ResetFieldsIfDisabled();
            }
        }
    }

    private string SelectedPps
    {
        get => _selectedPps;
        set
        {
            if (_selectedPps != value)
            {
                _selectedPps = value;
                ResetFieldsIfDisabled();
            }
        }
    }
    
    private string Pdg { get; set; } = string.Empty;
    private string ActivationPower { get; set; } = string.Empty;
    private string Trend { get; set; } = string.Empty;

    private bool IsBasicFieldsEnabled => 
        !string.IsNullOrEmpty(SelectedBlock) && SelectedBlock != "Select" &&
        !string.IsNullOrEmpty(SelectedPps) && SelectedPps != "Select";

    private bool IsTrendEnabled => 
        IsBasicFieldsEnabled && (SelectedPps == "aFRR+" || SelectedPps == "aFRR-");

    private void ResetFieldsIfDisabled()
    {
        if (!IsBasicFieldsEnabled)
        {
            Pdg = string.Empty;
            ActivationPower = string.Empty;
        }

        if (!IsTrendEnabled)
        {
            Trend = string.Empty;
        }
    }

    private void OnPdgChanged(ChangeEventArgs e) => Pdg = e.Value?.ToString() ?? string.Empty;
    private void OnActivationPowerChanged(ChangeEventArgs e) => ActivationPower = e.Value?.ToString() ?? string.Empty;
    private void OnTrendChanged(ChangeEventArgs e) => Trend = e.Value?.ToString() ?? string.Empty;

    private Modal instructionsModal = default!;
    private List<Instruction> instructions = new();

    // Chart related
    private System.Threading.Timer? timer;
    private Random random = new Random();
    private double lastValue = 50.0;
    private const string ChartCanvasId = "certificationChart";

    protected override void OnInitialized()
    {
        ppsList = PpsProvider.GetPpsValues();
        blocks = AggregationBlockProvider.GetAggregationBlocks();
        
        // Generate 20 dummy instructions
        var baseTime = DateTime.Today.AddHours(8);
        var randomInstr = new Random();
        for (int i = 0; i < 20; i++)
        {
            instructions.Add(new Instruction
            {
                Time = baseTime.AddMinutes(i * 15).ToString("HH:mm"),
                Power = Math.Round(randomInstr.NextDouble() * 100, 2)
            });
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initial data generation
            var labels = new List<string>();
            var data = new List<double>();

            double current = lastValue;
            for (int i = 0; i < 20; i++)
            {
                labels.Add(DateTime.Now.AddSeconds(-20 + i).ToString("HH:mm:ss"));
                data.Add(current);
                current += (random.NextDouble() - 0.5) * 10;
                current = Math.Clamp(current, 10, 100);
            }
            lastValue = current;

            // Initialize Chart via JS
            await JS.InvokeVoidAsync("window.chartWrapper.init", ChartCanvasId, labels, data);

            // Start timer for updates (every 1 second)
            timer = new System.Threading.Timer(async _ => await UpdateChart(), null, 1000, 1000);
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task UpdateChart()
    {
        var label = DateTime.Now.ToString("HH:mm:ss");
        var change = (random.NextDouble() - 0.5) * 10;
        var newVal = Math.Clamp(lastValue + change, 10, 100);
        lastValue = newVal;

        await InvokeAsync(async () =>
        {
            await JS.InvokeVoidAsync("window.chartWrapper.update", ChartCanvasId, label, newVal);
        });
    }

    private async Task ShowInstructions()
    {
        if (instructionsModal != null)
        {
            await instructionsModal.ShowAsync();
            StateHasChanged();
        }
    }

    private async Task HideModal()
    {
        await instructionsModal.HideAsync();
    }

    public async void Dispose()
    {
        timer?.Dispose();
        try
        {
            await JS.InvokeVoidAsync("window.chartWrapper.dispose", ChartCanvasId);
        }
        catch
        {
            // Ignore JS errors on dispose (e.g. if page is already closed)
        }
    }

    public class Instruction
    {
        public string Time { get; set; } = string.Empty;
        public double Power { get; set; }
    }
}
