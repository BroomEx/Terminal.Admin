@page "/settings"

<PageTitle>Settings</PageTitle>

<h1>Settings</h1>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">User Management</h5>
                <p class="card-text">Manage users and their access.</p>
                <a href="settings/users" class="btn btn-primary">Manage Users</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Role Management</h5>
                <p class="card-text">Manage system roles and permissions.</p>
                <a href="settings/roles" class="btn btn-primary">Manage Roles</a>
            </div>
        </div>
    </div>
</div>
