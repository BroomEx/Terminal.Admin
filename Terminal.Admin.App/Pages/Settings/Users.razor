@page "/settings/users"
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<IdentityUser> UserManager
@inject RoleManager<IdentityRole> RoleManager

<PageTitle>Users</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1>Users</h1>
    <div>
        <button class="btn btn-success me-2" @onclick="OpenCreateUserModal">Create User</button>
        <a href="settings" class="btn btn-outline-secondary">Back to Settings</a>
    </div>
</div>

@if (users == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Email</th>
                <th>Roles</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in users)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>
                        @if (userRoles.ContainsKey(user.Id))
                        {
                            @string.Join(", ", userRoles[user.Id])
                        }
                    </td>
                    <td>
                        <button class="btn btn-primary btn-sm" @onclick="() => ManageRoles(user)">Manage Roles</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@* Create User Modal *@
@if (showCreateUserModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create New User</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateUserModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(creationError))
                    {
                        <div class="alert alert-danger">@creationError</div>
                    }
                    <div class="mb-3">
                        <label for="newUserEmail" class="form-label">Email address</label>
                        <input type="email" class="form-control" id="newUserEmail" @bind="newUserEmail" placeholder="name@example.com">
                    </div>
                    <div class="mb-3">
                        <label for="newUserPassword" class="form-label">Password</label>
                        <input type="password" class="form-control" id="newUserPassword" @bind="newUserPassword">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseCreateUserModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="CreateUserAsync">Create</button>
                </div>
            </div>
        </div>
    </div>
}

@* Manage Roles Modal *@
@if (selectedUser != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Manage Roles for @selectedUser.Email</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @foreach (var role in allRoles)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" 
                                   checked="@(role.Name != null && selectedUserRoles.Contains(role.Name))" 
                                   @onchange="@(e => ToggleRole(role.Name, e.Value))" 
                                   id="role_@role.Id">
                            <label class="form-check-label" for="role_@role.Id">
                                @role.Name
                            </label>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<IdentityUser>? users;
    private Dictionary<string, IList<string>> userRoles = new();
    private List<IdentityRole> allRoles = new();
    
    // Manage Roles State
    private IdentityUser? selectedUser;
    private List<string> selectedUserRoles = new();

    // Create User State
    private bool showCreateUserModal = false;
    private string? newUserEmail;
    private string? newUserPassword;
    private string? creationError;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        users = await UserManager.Users.ToListAsync();
        allRoles = await RoleManager.Roles.ToListAsync();
        
        userRoles.Clear();
        foreach (var user in users)
        {
            var roles = await UserManager.GetRolesAsync(user);
            userRoles[user.Id] = roles;
        }
    }

    // Create User Methods
    private void OpenCreateUserModal()
    {
        showCreateUserModal = true;
        newUserEmail = string.Empty;
        newUserPassword = string.Empty;
        creationError = null;
    }

    private void CloseCreateUserModal()
    {
        showCreateUserModal = false;
        creationError = null;
    }

    private async Task CreateUserAsync()
    {
        creationError = null;

        if (string.IsNullOrWhiteSpace(newUserEmail) || string.IsNullOrWhiteSpace(newUserPassword))
        {
            creationError = "Email and Password are required.";
            return;
        }

        var user = new IdentityUser { UserName = newUserEmail, Email = newUserEmail };
        var result = await UserManager.CreateAsync(user, newUserPassword);

        if (result.Succeeded)
        {
            // Specifically confirm email so the user can sign in if that setting is enabled (it is in Program.cs)
            // options.SignIn.RequireConfirmedAccount = true
            // In a real app, we might want to send an email, but for an admin tool, auto-confirming is often desired.
            // However, the prompt didn't specify auto-confirm, but it's a safe bet for a "Create User" admin function.
            // Let's check if the token generation is needed or if we can just set the flag.
            // We can just set the property if we were using EF directly, but via UserManager we can use a token.
            // Or simpler: just create it. If login fails, I might need to add confirmation logic.
            // Given "options.SignIn.RequireConfirmedAccount = true" in Program.cs, I should probably confirm it.
            
            var token = await UserManager.GenerateEmailConfirmationTokenAsync(user);
            await UserManager.ConfirmEmailAsync(user, token);

            await LoadData();
            CloseCreateUserModal();
        }
        else
        {
            creationError = string.Join(" ", result.Errors.Select(e => e.Description));
        }
    }

    // Manage Roles Methods
    private async Task ManageRoles(IdentityUser user)
    {
        selectedUser = user;
        selectedUserRoles = (await UserManager.GetRolesAsync(user)).ToList();
    }

    private void CloseModal()
    {
        selectedUser = null;
        selectedUserRoles.Clear();
    }

    private async Task ToggleRole(string? roleName, object? isChecked)
    {
        if (selectedUser == null || roleName == null) return;

        bool checkedState = (bool)(isChecked ?? false);

        if (checkedState)
        {
            if (!selectedUserRoles.Contains(roleName))
            {
                await UserManager.AddToRoleAsync(selectedUser, roleName);
                selectedUserRoles.Add(roleName);
            }
        }
        else
        {
            if (selectedUserRoles.Contains(roleName))
            {
                await UserManager.RemoveFromRoleAsync(selectedUser, roleName);
                selectedUserRoles.Remove(roleName);
            }
        }
        
        // Refresh the list view
        userRoles[selectedUser.Id] = await UserManager.GetRolesAsync(selectedUser);
    }
}